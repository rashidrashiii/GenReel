{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rashidrashiii/GenReel/video-script.schema.json",
  "title": "VideoScript",
  "description": "A short animated explainer as a list of beats (docs/VISUAL_UPGRADE.md, docs/SCENES.md). Each beat is 1-3 s; joined narrations are the voiceover.",
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "language", "music", "background", "beats"],
  "properties": {
    "title": { "type": "string", "minLength": 1, "maxLength": 80 },
    "language": { "type": "string", "enum": ["en", "ml", "hi", "ta"] },
    "voice": { "type": "string", "enum": ["warm_female", "calm_male", "energetic_female", "energetic_male"], "default": "warm_female" },
    "music": { "type": "string", "enum": ["none", "calm", "upbeat", "festive", "serious"] },
    "background": { "$ref": "#/$defs/background" },
    "beats": { "type": "array", "minItems": 6, "maxItems": 45, "items": { "$ref": "#/$defs/beat" } }
  },
  "$defs": {
    "background": { "type": "string", "enum": ["city", "shop", "nature", "studio", "abstract", "night"] },
    "prop": {
      "type": "object", "additionalProperties": false, "required": ["tag"],
      "properties": {
        "tag": { "type": "string", "minLength": 1, "maxLength": 40, "description": "A tag from the prop list given in the prompt." },
        "enter": { "type": "string", "enum": ["pop", "slide_up", "drop", "draw_on", "wipe_in"] },
        "idle": { "type": "string", "enum": ["float", "pulse", "wobble", "none"] }
      }
    },
    "beat": {
      "type": "object", "additionalProperties": false, "required": ["narration", "layout"],
      "properties": {
        "narration": { "type": "string", "minLength": 1, "maxLength": 90, "description": "Spoken words for this beat, 3-9 words (Malayalam 3-7). Shown as word-by-word captions." },
        "emphasis": { "type": "array", "maxItems": 2, "items": { "type": "integer", "minimum": 0 }, "description": "0-based indexes of words in this beat's narration to stress." },
        "layout": { "type": "string", "enum": ["stack", "hero", "row", "number", "diagram", "presenter_big"] },
        "presenter": {
          "type": "object", "additionalProperties": false, "required": ["pose"],
          "properties": {
            "pose": { "type": "string", "enum": ["neutral", "point", "thumbs_up", "surprised", "explain"] },
            "side": { "type": "string", "enum": ["left", "center", "right"] }
          }
        },
        "props": { "type": "array", "maxItems": 3, "items": { "$ref": "#/$defs/prop" } },
        "number": {
          "type": "object", "additionalProperties": false, "required": ["value", "label"],
          "properties": { "value": { "type": "string", "minLength": 1, "maxLength": 16 }, "label": { "type": "string", "maxLength": 40 } }
        },
        "diagram": {
          "type": "object", "additionalProperties": false, "required": ["kind", "nodes"],
          "properties": {
            "kind": { "type": "string", "enum": ["row", "column", "cycle"] },
            "nodes": {
              "type": "array", "minItems": 2, "maxItems": 5,
              "items": { "type": "object", "additionalProperties": false, "required": ["label"], "properties": { "label": { "type": "string", "minLength": 1, "maxLength": 28 }, "tag": { "type": "string", "maxLength": 40 } } }
            }
          }
        },
        "camera": { "type": "string", "enum": ["push_in", "pull_out", "pan_left", "pan_right", "shake_punch", "none"] },
        "transition": { "type": "string", "enum": ["cut", "whip", "zoom", "iris"] },
        "sfx": { "type": "string", "enum": ["whoosh", "pop", "ding", "thud", "tick", "swipe", "none"] },
        "background": { "$ref": "#/$defs/background" },
        "photo": {
          "type": "object", "additionalProperties": false, "required": ["upload_path"],
          "description": "Set only by the app when the user picks one of their own photos for this beat; the model never sets it.",
          "properties": { "upload_path": { "type": "string", "minLength": 1, "maxLength": 300 } }
        }
      }
    }
  }
}
